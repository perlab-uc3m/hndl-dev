+    size_t written = 0, total = 0;
+    while (total < response_size) {
+        size_t chunk = response_size - total;
+        if (!SSL_write_ex2(conn, response + total, chunk,
+                           (total + chunk >= response_size)
+                               ? SSL_WRITE_FLAG_CONCLUDE : 0,
+                           &written)) {
+            fprintf(stderr, "write failed at offset %zu\n", total);
+            ERR_print_errors_fp(stderr);
+            free(response);
+            return 0;
