# OpenSSL 3.6.0 QUIC Server Demo Patch
#
# Extends the upstream demos/quic/server/server.c with the minimal additions
# needed for the HN-DL capture pipeline:
#
#   - NSS keylog callback (-k <path>)   → ground-truth verification
#   - Configurable response size (-n N) → α measurements at varying payloads
#   - Group selection (-g <groups>)     → test different curves
#   - One-shot mode (-1)               → scripted capture
#   - SO_REUSEADDR on UDP socket       → rapid test re-runs
#   - getopt-based CLI replacing positional args
#
# These additions total ~80 lines of straightforward C.  The rest of the
# upstream demo (SSL_new_listener, ALPN, blocking accept loop) is unchanged.
#
# Apply:
#   cd openssl/src/openssl
#   patch -p1 < ../../../patches/openssl-3.6.0-quic-server.patch
#
# Build:
#   bash scripts/build_quic_server.sh
#
--- a/demos/quic/server/server.c	2025-11-07 11:34:42.590618300 +0100
+++ b/demos/quic/server/server.c	2026-02-24 00:01:49.274291461 +0100
@@ -6,12 +6,23 @@
  * in the file LICENSE in the source distribution or at
  * https://www.openssl.org/source/license.html
  */
+
+/*
+ * HN-DL patch additions (see patches/openssl-3.6.0-quic-server.patch):
+ *   -k <path>   Write NSS keylog for ground-truth verification
+ *   -n <bytes>  Response payload size (default 256)
+ *   -g <groups> TLS 1.3 groups (default X25519)
+ *   -1          Exit after one connection (scripted capture)
+ */
+
 #include <openssl/err.h>
 #include <openssl/ssl.h>
 #include <openssl/quic.h>
 #ifdef _WIN32 /* Windows */
 # include <winsock2.h>
 #else /* Linux/Unix */
+# include <getopt.h>
+# include <stdlib.h>
 # include <netinet/in.h>
 # include <unistd.h>
 #endif
@@ -22,6 +33,18 @@
  * a time is accepted in a blocking loop.
  */
 
+/* ---- Keylog callback -------------------------------------------------- */
+
+static FILE *keylog_fp = NULL;
+
+static void keylog_callback(const SSL *ssl, const char *line)
+{
+    if (keylog_fp == NULL)
+        return;
+    fprintf(keylog_fp, "%s\n", line);
+    fflush(keylog_fp);
+}
+
 /* ALPN string for TLS handshake */
 static const unsigned char alpn_ossltest[] = {
     /* "\x08ossltest" (hex for EBCDIC resilience) */
@@ -43,7 +66,8 @@
 }
 
 /* Create SSL_CTX. */
-static SSL_CTX *create_ctx(const char *cert_path, const char *key_path)
+static SSL_CTX *create_ctx(const char *cert_path, const char *key_path,
+                           const char *keylog_path, const char *groups)
 {
     SSL_CTX *ctx;
 
@@ -69,6 +93,23 @@
 
     /* Setup ALPN negotiation callback. */
     SSL_CTX_set_alpn_select_cb(ctx, select_alpn, NULL);
+
+    /* TLS 1.3 groups (default X25519) */
+    if (groups && !SSL_CTX_set1_groups_list(ctx, groups)) {
+        fprintf(stderr, "failed to set groups: %s\n", groups);
+        goto err;
+    }
+
+    /* Keylog callback for ground-truth verification */
+    if (keylog_path) {
+        keylog_fp = fopen(keylog_path, "a");
+        if (!keylog_fp) {
+            fprintf(stderr, "cannot open keylog: %s\n", keylog_path);
+            goto err;
+        }
+        SSL_CTX_set_keylog_callback(ctx, keylog_callback);
+    }
+
     return ctx;
 
 err:
@@ -87,6 +128,9 @@
         goto err;
     }
 
+    int reuse = 1;
+    setsockopt(fd, SOL_SOCKET, SO_REUSEADDR, &reuse, sizeof(reuse));
+
     sa.sin_family  = AF_INET;
     sa.sin_port    = htons(port);
 
@@ -105,39 +149,56 @@
 }
 
 /* Main loop for servicing a single incoming QUIC connection. */
-static int run_quic_conn(SSL *conn)
+static int run_quic_conn(SSL *conn, size_t response_size)
 {
-    size_t written = 0;
+    char buf[4096];
