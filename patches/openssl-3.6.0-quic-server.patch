-    if (SSL_shutdown(conn) != 1) {
-        ERR_print_errors_fp(stderr);
-        return 0;
-    }
+    SSL_shutdown(conn);
 
     fprintf(stderr, "=> Finished with connection\n");
     return 1;
 }
 
